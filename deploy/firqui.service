[Unit]
Description=Firqui Jewels backend (Spring Boot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=firqui
Group=firqui
# uploads/ and private_storage/ are created relative to this directory
WorkingDirectory=/var/lib/firqui
EnvironmentFile=/etc/firqui/firqui.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/firqui/app/firqui.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
