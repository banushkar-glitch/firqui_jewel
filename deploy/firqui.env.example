# Firqui Jewels - production environment
# The real file lives on the server at /etc/firqui/firqui.env (created by setup-server.sh
# with random secrets). Never commit the real file.
# Plain KEY=value lines, no quotes. Restart after editing: sudo systemctl restart firqui

SPRING_PROFILES_ACTIVE=prod

# Database (PostgreSQL on the same server; point DB_URL at an RDS endpoint to move later)
DB_URL=jdbc:postgresql://localhost:5432/firqui_jewels
DB_USERNAME=firqui
DB_PASSWORD=change-me

# Long random string, at least 32 characters:  openssl rand -hex 48
JWT_SECRET=change-me

# Admin account created on first startup
ADMIN_EMAIL=admin@firquijewels.com
ADMIN_PASSWORD=change-me

# Site address
FRONTEND_URL=https://firquijewels.com
CORS_ALLOWED_ORIGINS=https://firquijewels.com,https://www.firquijewels.com

# Email for the Contact Us form and "forgot password" (leave username empty to disable sending)
# Gmail / Google Workspace needs an App Password here, not the account password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Where Contact Us messages are delivered
CONTACT_EMAIL=info@firquijewels.com

# UPI account that receives payments; the payment page shows a QR with the exact order amount
UPI_ID=nehaa067@icici
UPI_PAYEE_NAME=FIRQUI JEWELS
