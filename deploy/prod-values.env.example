# Firqui Jewels - shop settings for the live server
#
# Copy this file OUTSIDE the repository (e.g. D:\Jewels\firqui-prod.env), fill it in,
# then send it to the server and apply it with deploy/set-env.sh (see that script).
# Never commit the filled-in file. Plain KEY=value lines, no quotes.

# --- Email (order notifications, Contact Us, password reset) -----------------
# The mailbox that sends the emails
SPRING_MAIL_USERNAME=info@firquijewels.com
# 16-character Google App Password for that mailbox (spaces are fine to remove)
SPRING_MAIL_PASSWORD=

# Where Contact Us messages and new-order emails are delivered
CONTACT_EMAIL=info@firquijewels.com

# --- Payments ---------------------------------------------------------------
# UPI ID shown in the payment QR. A business/merchant UPI ID locks the amount
# in customers' UPI apps; a personal one lets them edit it.
UPI_ID=
UPI_PAYEE_NAME=FIRQUI JEWELS

# --- Site address (only if different from the domain given to setup-server.sh)
# FRONTEND_URL=https://firquijewels.com
# CORS_ALLOWED_ORIGINS=https://firquijewels.com,https://www.firquijewels.com
